{
  "name": "ci-glasses-app",
  "version": "0.1.0",
  "description": "Even Hub app for G2 smart glasses with CI-server agentic AI integration",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "pack:ehpk": "npm run build && evenhub pack app.json dist --output ci-companion.ehpk",
    "pack:check": "npm run build && evenhub pack app.json dist --output ci-companion.ehpk --check",
    "qr": "evenhub qr --port 5173",
    "simulator": "evenhub-simulator http://localhost:5173/",
    "lint:canon": "ci-lint-canon . && node scripts/sync-brand.mjs --check",
    "brand:sync": "node scripts/sync-brand.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@companionintelligence/tokens": "^1.0.0",
    "@fontsource-variable/manrope": "^5.2.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.13",
    "@evenrealities/evenhub-simulator": "^0.7.3",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "@companionintelligence/config": "^1.0.0",
    "@companionintelligence/assets": "^1.0.0"
  }
}
